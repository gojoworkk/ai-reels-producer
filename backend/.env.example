# Бэкенд Reels Finder. Ключи Apify и Anthropic вписываются сюда.
DATABASE_URL=postgresql+psycopg://reels@127.0.0.1:5433/reels

# Apify — скачивание рилсов и транскриптов: https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Anthropic — написание сценариев: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Общий секрет между front-end и API (сгенерирован автоматически)
API_TOKEN=

PUBLIC_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Автообновление конкурентов через Apify, часов. 0 — выключено.
SYNC_INTERVAL_HOURS=24
