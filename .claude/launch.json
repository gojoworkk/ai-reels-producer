{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ai-reels",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:web"
      ],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/py.mjs",
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--port",
        "8000",
        "--reload",
        "--reload-dir",
        "backend/app"
      ],
      "port": 8000
    }
  ]
}
