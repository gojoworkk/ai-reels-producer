# Скопируйте в .env.local и заполните.

# Apify — скачивание рилсов и транскриптов: https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Anthropic — написание сценариев: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Необязательно: другая модель Claude (по умолчанию claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
